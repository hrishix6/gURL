{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "pnpm",
		"analytics": false
	},
	"newProjectRoot": "projects",
	"projects": {
		"gurl": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": ["src/styles.css"]
					},
					"configurations": {
						"web-prod": {
							"outputPath": "dist/gurl",
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2MB",
									"maximumError": "5MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"desktop-prod": {
							"outputPath": "../shared/assets/static",
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2MB",
									"maximumError": "5MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"web-dev": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						},
						"desktop-dev": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true,
							"outputPath": "../shared/assets/static"
						}
					},
					"defaultConfiguration": "desktop-prod"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"desktop-prod": {
							"buildTarget": "gurl:build:desktop-prod"
						},
						"desktop-dev": {
							"buildTarget": "gurl:build:desktop-dev"
						},
						"web-prod": {
							"buildTarget": "gurl:build:web-prod"
						},
						"web-dev": {
							"buildTarget": "gurl:build:web-dev",
							"proxyConfig": "src/proxy.conf.json"
						}
					},
					"defaultConfiguration": "desktop-dev"
				},
				"test": {
					"builder": "@angular/build:unit-test"
				}
			}
		}
	}
}
